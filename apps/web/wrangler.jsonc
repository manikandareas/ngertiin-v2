{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ngertiin-web",
  "compatibility_date": "2026-09-10",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "app-ngertiin.whoismanik.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
