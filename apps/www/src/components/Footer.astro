---
import { contact, policyLinks } from "../lib/contact";
import Brand from "./Brand.astro";
import { dashboardUrl, navigationLinks, signInUrl } from "../lib/links";
---

<footer class="wrap flex flex-wrap items-center justify-between gap-6 py-10">
  <div>
    <Brand /><p class="mt-2 text-sm text-muted-foreground">Selangkah lebih ngerti.</p>
  </div><nav aria-label="Navigasi footer" class="flex flex-wrap gap-x-6 gap-y-4 text-sm">
    {
      navigationLinks.map(({ href, label }) => (
        <a href={Astro.url.pathname === "/" ? href : `/${href}`}>{label}</a>
      ))
    }<a href={signInUrl}>Masuk</a><a href={dashboardUrl}>Buka aplikasi ↗</a>
  </nav>
  <div class="w-full border-t-2 border-border pt-6 text-sm text-muted-foreground">
    <nav aria-label="Informasi dan kebijakan" class="flex flex-wrap gap-x-6 gap-y-4">
      {policyLinks.map(({ href, label }) => <a href={href}>{label}</a>)}
    </nav>
    <p class="mt-5">Ngerti.in dikelola oleh {contact.businessName}, usaha individu.</p>
    <p>{contact.address}</p>
    <p class="mt-2 flex flex-wrap gap-x-5 gap-y-2">
      <a class="underline underline-offset-4" href={contact.emailUrl}>{contact.email}</a>
      <a class="underline underline-offset-4" href={contact.whatsappUrl}
        >WhatsApp: {contact.phone}</a
      >
    </p>
  </div>
</footer>
