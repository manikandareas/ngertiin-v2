---
interface Props {
  name: string;
  width: number;
  label: string;
  poster: string;
}

const { name, width, label, poster } = Astro.props;
const controlClass =
  "inline-flex min-h-11 min-w-11 cursor-pointer items-center justify-center rounded-[10px] px-2 font-[750] hover:bg-muted focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-primary motion-safe:active:scale-96";
---

<dialog
  data-video-dialog
  class="m-auto max-h-dvh max-w-screen overflow-auto border-0 bg-transparent p-3 text-foreground backdrop:bg-black/65 backdrop:backdrop-blur-[10px] sm:p-5"
  aria-labelledby={`${name}-video-title`}
>
  <div
    data-video-content
    class="video-dialog-content overflow-hidden rounded-2xl border border-border bg-background shadow-[0_24px_80px_rgb(0_0_0/0.3)] sm:rounded-[20px]"
    style={`--video-ratio: ${width} / 1080; --video-width: calc(${(width / 1080) * 100}dvh - ${(width / 1080) * 220}px)`}
  >
    <header class="flex items-center justify-between gap-4 px-4 py-2 sm:px-5">
      <h2 id={`${name}-video-title`} class="text-sm font-bold sm:text-base">{label}</h2>
      <button
        data-close
        type="button"
        class:list={[controlClass, "shrink-0"]}
        aria-label="Tutup video"
        autofocus
        ><svg
          viewBox="0 0 24 24"
          width="22"
          height="22"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"><path d="m6 6 12 12M6 18 18 6"></path></svg
        ></button
      >
    </header>
    <video
      data-modal-video
      class="video-modal-media block h-auto w-full cursor-pointer bg-black object-contain"
      width={width}
      height="1080"
      poster={poster}
      preload="none"
      muted
      playsinline
      aria-label={label}></video>
    <div class="grid gap-1 px-2.5 pt-2 pb-3 sm:px-4">
      <input
        data-seek
        type="range"
        min="0"
        max="0"
        step="0.1"
        value="0"
        aria-label="Posisi video"
        disabled
        class="min-h-7 w-full cursor-pointer accent-primary focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-primary"
      />
      <div class="flex flex-wrap items-center gap-2">
        <button data-play type="button" class={controlClass} aria-label="Putar video">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"
            ><path data-play-icon d="M8 5v14l11-7z"></path></svg
          >
        </button>
        <span data-time class="mr-auto text-xs tabular-nums">0:00 / 0:00</span>
        <button data-fullscreen type="button" class={controlClass} aria-label="Layar penuh"
          ><svg
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5"></path></svg
          ></button
        >
      </div>
      <p data-status role="status" class="text-center text-xs text-muted-foreground" hidden></p>
    </div>
  </div>
</dialog>
