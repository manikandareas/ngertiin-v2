---
import Button from "./Button.astro";
import { navigationLinks, signInUrl } from "../lib/links";
---

<details class="mobile-menu sm:hidden">
  <summary aria-label="Menu navigasi">
    <svg
      class="menu-open"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"></path></svg
    >
    <svg
      class="menu-close"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      aria-hidden="true"><path d="m6 6 12 12M6 18 18 6"></path></svg
    >
  </summary>
  <nav aria-label="Navigasi mobile">
    {navigationLinks.map(({ href, label }) => <a href={href}>{label}</a>)}
    <Button href={signInUrl} variant="outline">Masuk</Button>
  </nav>
</details>
<style>
  summary {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 2px solid var(--border);
    border-radius: var(--button-radius);
    color: var(--link);
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    background: var(--accent);
  }
  summary:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 4px;
  }
  .menu-close,
  details[open] .menu-open {
    display: none;
  }
  details[open] .menu-close {
    display: block;
  }
  .mobile-menu nav {
    position: absolute;
    top: calc(100% - 8px);
    left: 0;
    right: 0;
    z-index: 3;
    display: grid;
    gap: 8px;
    padding: 16px;
    background: var(--background);
    border: 2px solid var(--border);
    border-radius: var(--card-radius);
    box-shadow: 0 4px 0 var(--border);
  }
  .mobile-menu nav > a {
    padding: 12px;
  }
</style>
<script>
  const menu = document.querySelector<HTMLDetailsElement>(".mobile-menu");
  const trigger = menu?.querySelector("summary");
  menu?.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu.open) {
      menu.open = false;
      trigger?.focus();
    }
  });
  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menu.open = false;
      const href = link.getAttribute("href");
      const target = href?.startsWith("#") ? document.querySelector<HTMLElement>(href) : null;
      if (target) {
        target.tabIndex = -1;
        target.focus({ preventScroll: true });
      }
    });
  });
  document.addEventListener("click", (event) => {
    if (menu?.open && event.target instanceof Node && !menu.contains(event.target))
      menu.open = false;
  });
  matchMedia("(min-width: 640px)").addEventListener("change", () => {
    if (menu) menu.open = false;
  });
</script>
