---
import "../styles/global.css";
const title = "Ngerti.in: Ubah Materimu Jadi Alur Belajar yang Mudah Dipahami";
const description =
  "Ubah PDF, artikel, atau catatanmu menjadi modul belajar interaktif. Kuasai materi lebih terarah lewat alur belajar terstruktur, flashcard, kuis, dan penguatan konsep otomatis.";
const siteUrl = new URL(import.meta.env.PUBLIC_SITE_URL || "http://localhost:4321");
if (!["http:", "https:"].includes(siteUrl.protocol)) {
  throw new Error("PUBLIC_SITE_URL must be an HTTP(S) URL");
}
const canonical = new URL(Astro.url.pathname, siteUrl);
const socialImage = new URL("/web-app-manifest-512x512.png", siteUrl);
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width" />
    <title>{title}</title><meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" /><meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content="Ngerti.in" /><meta property="og:title" content={title} />
    <meta property="og:description" content={description} /><meta
      property="og:url"
      content={canonical}
    />
    <meta property="og:image" content={socialImage} /><meta
      property="og:image:alt"
      content="Identitas Ngerti.in"
    />
    <meta name="twitter:card" content="summary" /><meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} /><meta
      name="twitter:image"
      content={socialImage}
    />
  </head>
  <body><a class="skip-link" href="#konten">Lewati ke konten</a><slot /></body>
</html>
