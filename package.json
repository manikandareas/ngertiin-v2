{
  "name": "ngertiin",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter './apps/*' dev",
    "dev:web": "bun --cwd apps/web dev",
    "dev:api": "bun --cwd apps/api dev",
    "dev:worker": "bun --cwd apps/worker dev",
    "build": "bun --filter '@ngertiin/*' build",
    "typecheck": "bun --filter '@ngertiin/*' typecheck",
    "lint": "biome lint .",
    "format": "biome format --write . && bun --filter @ngertiin/www format",
    "format:check": "biome format . && bun --filter @ngertiin/www format:check",
    "db:generate": "bun --cwd packages/database db:generate",
    "db:migrate": "bun --cwd packages/database db:migrate",
    "db:check": "bun --cwd packages/database db:check",
    "db:studio": "bun --cwd packages/database db:studio",
    "infra:config": "docker compose config --quiet",
    "infra:up": "docker compose up -d --wait postgres redis minio && docker compose run --rm --no-deps minio-init",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "release:check": "bun install --frozen-lockfile && bun infra:config && bun db:check && bun typecheck && bun lint && bun format:check && bun run build && git diff --check",
    "release:integrity": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f docs/release/m9-integrity-check.sql",
    "dev:www": "bun --cwd apps/www dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/bun": "1.4.0",
    "typescript": "6.0.2",
    "wrangler": "4.130.0"
  }
}
