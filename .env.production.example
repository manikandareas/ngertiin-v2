# Copy into Dokploy backend Environment; all values here are examples.
# CI publishes ghcr.io/<lowercase-owner>/<lowercase-repo>-api:<commit>, etc.
BACKEND_IMAGE=ghcr.io/manikandareas/ngertiin-v2
RELEASE_TAG=replace-with-full-commit-sha
BACKEND_NETWORK=replace-with-dokploy-database-network
DATABASE_URL=postgres://ngertiin:replace-me@postgres-internal-host:5432/ngertiin
REDIS_URL=redis://:replace-me@redis-internal-host:6379
S3_ENDPOINT=https://replace-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_BUCKET=ngertiin-production
S3_FORCE_PATH_STYLE=true
CLERK_SECRET_KEY=sk_live_replace_me
OPENAI_API_KEY=replace-me
OPENAI_MODEL=replace-with-validated-model
AI_IMAGE_INPUT_ENABLED=true
MISTRAL_API_KEY=replace-me
MISTRAL_OCR_MODEL=mistral-ocr-latest
FIRECRAWL_API_KEY=replace-me
SOURCE_PDF_MAX_BYTES=26214400
SOURCE_URL_MAX_CODE_POINTS=500000
USAGE_MODULES_WEEKLY_LIMIT=10
USAGE_SOURCES_WEEKLY_LIMIT=40
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_READ_MAX=120
RATE_LIMIT_MUTATION_MAX=60
RATE_LIMIT_EXPENSIVE_MAX=10
RATE_LIMIT_STREAM_MAX=10
WIKIMEDIA_USER_AGENT="NgertiinLessonImages/1.0 (https://ngertiin.whoismanik.dev)"

# AI chat is always enabled. Apply database migrations before starting services.
# Choose explicitly; independent of OPENAI_MODEL. Required for API startup.
OPENAI_CHAT_MODEL=replace-with-validated-chat-model
CHAT_INPUT_MAX_CODE_POINTS=8000
CHAT_PROMPT_MAX_TOKENS=16000
CHAT_OUTPUT_MAX_TOKENS=8192
CHAT_RUN_TIMEOUT_MS=240000
CHAT_PROVIDER_TIMEOUT_MS=180000
CHAT_UPLOAD_RATE_LIMIT_PER_MINUTE=10
CHAT_CANCEL_RATE_LIMIT_PER_MINUTE=60
CHAT_SHUTDOWN_DRAIN_MS=30000
CHAT_PROVIDER_MAX_RETRIES=1
CHAT_MAX_EXECUTING_RUNS_PER_INSTANCE=4
CHAT_LEASE_MS=30000
CHAT_HEARTBEAT_MS=5000
CHAT_SWEEP_INTERVAL_MS=5000
CHAT_SNAPSHOT_INTERVAL_MS=500
CHAT_IDEMPOTENCY_RETENTION_HOURS=168

# Knowledge M4: apply pgvector migration before starting API/worker.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
KNOWLEDGE_INDEX_VERSION=1
KNOWLEDGE_CHUNK_TOKENS=600
KNOWLEDGE_CHUNK_OVERLAP_TOKENS=80
KNOWLEDGE_SEARCH_CANDIDATES=20
KNOWLEDGE_SEARCH_TOP_K=6
KNOWLEDGE_RRF_K=60
KNOWLEDGE_EMBEDDING_BATCH_SIZE=32
KNOWLEDGE_INDEX_CONCURRENCY=2
KNOWLEDGE_RECONCILE_INTERVAL_MS=60000
KNOWLEDGE_OBSOLETE_RETENTION_HOURS=24
