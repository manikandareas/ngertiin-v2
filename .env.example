OPENAI_MODEL=replace_me
# Disable only for models that do not accept image input.
AI_IMAGE_INPUT_ENABLED=true
# Identify the application to Wikimedia; use your deployment contact URL.
WIKIMEDIA_USER_AGENT="NgertiinLessonImages/1.0 (https://ngerti.in)"
